{
	"name": "armen-articles",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "Static technical publication for articles.armenderoian.dev",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "astro dev",
		"sync": "astro sync",
		"build": "astro build && pagefind --site dist && node scripts/generate-headers.ts",
		"preview": "astro preview",
		"preview:worker": "wrangler dev",
		"check": "astro check",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:integration": "vitest run --project integration",
		"test:e2e": "playwright test",
		"validate": "npm run check && npm run lint && npm run format:check && npm test",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.2",
		"@astrojs/mdx": "^8.0.3",
		"@astrojs/react": "^7.0.1",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@expressive-code/plugin-line-numbers": "^0.44.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.8",
		"astro-expressive-code": "^0.44.2",
		"katex": "^0.19.0",
		"mermaid": "^12.1.0",
		"pagefind": "^1.5.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"remark-math": "^6.0.0",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.3",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.2.1",
		"globals": "^17.13.0",
		"htmlparser2": "^12.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.4",
		"wrangler": "^4.149.0"
	},
	"overrides": {
		"katex": "$katex",
		"postcss-selector-parser": "^7.1.6"
	}
}
