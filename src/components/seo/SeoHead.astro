---
import { site } from '@/data/site';
import { serializeJsonLd } from '@/lib/metadata/structured-data';
import { absoluteUrl, publicPath, routes } from '@/lib/utils/routes';

export interface ArticleMetadata {
	publishedAt: Date;
	updatedAt?: Date | undefined;
	section: string;
	tags: string[];
	author: string;
}

export interface Props {
	title: string;
	description: string;
	/** Absolute canonical URL. Defaults to the current page on the production origin. */
	canonical?: string | undefined;
	/** Absolute URL of the social preview image. */
	image?: string | undefined;
	imageAlt?: string | undefined;
	type?: 'website' | 'article';
	article?: ArticleMetadata | undefined;
	noindex?: boolean;
	jsonLd?: unknown[];
}

const {
	title,
	description,
	canonical = absoluteUrl(publicPath(Astro.url.pathname)),
	image = absoluteUrl(site.defaultSocialImage),
	imageAlt = site.name,
	type = 'website',
	article,
	noindex = false,
	jsonLd = []
} = Astro.props;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="author" content={article?.author ?? site.author.name} />

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale.replace('-', '_')} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

{article && (
	<>
		<meta property="article:published_time" content={article.publishedAt.toISOString()} />
		{article.updatedAt && (
			<meta property="article:modified_time" content={article.updatedAt.toISOString()} />
		)}
		<meta property="article:author" content={article.author} />
		<meta property="article:section" content={article.section} />
		{article.tags.map((tag) => (
			<meta property="article:tag" content={tag} />
		))}
	</>
)}

<link
	rel="alternate"
	type="application/rss+xml"
	title={`${site.name} RSS feed`}
	href={absoluteUrl(routes.rss)}
/>
<link rel="sitemap" href="/sitemap-index.xml" />

{jsonLd.map((data) => (
	<script type="application/ld+json" set:html={serializeJsonLd(data)} />
))}
