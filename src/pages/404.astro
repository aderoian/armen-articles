---
import SearchForm from '@/components/search/SearchForm.astro';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { routes } from '@/lib/utils/routes';
---

<BaseLayout
	title={`Page not found · ${site.author.name}`}
	description="The page you were looking for does not exist."
	noindex
>
	<div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24">
		<p class="text-accent font-mono text-sm font-semibold">404</p>
		<h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Page not found</h1>
		<p class="text-muted mt-4 text-lg">
			The page may have moved or never existed. Try searching, or start from the archive.
		</p>
		<div class="mt-8">
			<SearchForm id="not-found-search" />
		</div>
		<ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
			<li>
				<a href={routes.home}>Home</a>
			</li>
			<li>
				<a href={routes.articles}>All articles</a>
			</li>
			<li>
				<a href={routes.categories}>Categories</a>
			</li>
			<li>
				<a href={routes.tags}>Tags</a>
			</li>
		</ul>
	</div>
</BaseLayout>
