---
import PageHeader from '@/components/ui/PageHeader.astro';
import { series, seriesKeys } from '@/data/series';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getArticles } from '@/lib/articles/collection';
import { seriesArticles } from '@/lib/articles/series';
import { routes } from '@/lib/utils/routes';

const articles = await getArticles();
const items = seriesKeys
	.map((key) => ({ key, ...series[key], parts: seriesArticles(articles, key).length }))
	.filter((item) => item.parts > 0);
---

<BaseLayout
	title={`Series · ${site.author.name}`}
	description="Multi-part articles meant to be read in order."
>
	<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
		<PageHeader title="Series" description="Multi-part articles meant to be read in order." />
		{items.length > 0 ? (
			<ul class="flex flex-col gap-4">
				{items.map((item) => (
					<li class="border-border hover:border-border-strong relative rounded-lg border p-5">
						<h2 class="text-lg font-semibold">
							<a
								href={routes.series(item.key)}
								class="text-text hover:text-accent no-underline after:absolute after:inset-0"
							>
								{item.title}
							</a>
						</h2>
						<p class="text-muted mt-1">{item.description}</p>
						<p class="text-muted mt-3 text-sm">
							{item.parts} {item.parts === 1 ? 'part' : 'parts'}
						</p>
					</li>
				))}
			</ul>
		) : (
			<p class="text-muted">No series have been published yet.</p>
		)}
	</div>
</BaseLayout>
