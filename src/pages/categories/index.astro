---
import PageHeader from '@/components/ui/PageHeader.astro';
import { categories, categoryKeys } from '@/data/categories';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getArticles } from '@/lib/articles/collection';
import { countByCategory } from '@/lib/articles/taxonomy';
import { routes } from '@/lib/utils/routes';

const counts = countByCategory(await getArticles());
const items = categoryKeys
	.filter((key) => counts.has(key))
	.map((key) => ({ key, ...categories[key], count: counts.get(key) ?? 0 }));
---

<BaseLayout
	title={`Categories · ${site.author.name}`}
	description="Browse articles by subject area."
>
	<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
		<PageHeader title="Categories" description="Browse articles by subject area." />
		<ul class="grid gap-4 sm:grid-cols-2">
			{items.map((item) => (
				<li class="border-border hover:border-border-strong relative rounded-lg border p-5">
					<h2 class="text-lg font-semibold">
						<a
							href={routes.category(item.key)}
							class="text-text hover:text-accent no-underline after:absolute after:inset-0"
						>
							{item.title}
						</a>
					</h2>
					<p class="text-muted mt-1 text-sm">{item.description}</p>
					<p class="text-muted mt-3 text-sm">
						{item.count} {item.count === 1 ? 'article' : 'articles'}
					</p>
				</li>
			))}
		</ul>
	</div>
</BaseLayout>
